#include <stdio.h>
#include <string.h>

int main()
{
    char lhs, alpha[20], beta[20];

    printf("Grammar:\n");
    printf("L -> L,S | S\n\n");

    lhs = 'L';
    strcpy(alpha, ",S");
    strcpy(beta, "S");

    printf("Grammar after eliminating left recursion:\n");
    printf("%c  -> %s%c'\n", lhs, beta, lhs);
    printf("%c' -> %s%c' | e\n", lhs, alpha, lhs);

    return 0;
}
