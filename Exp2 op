#include <stdio.h>
#include <string.h>

int main()
{
    char str[200];

    printf("Enter a line: ");
    fgets(str, sizeof(str), stdin);

    if ((str[0] == '/' && str[1] == '/') ||
        (str[0] == '/' && str[1] == '*'))
        printf("It is a comment.\n");
    else
        printf("It is not a comment.\n");

    return 0;
}
