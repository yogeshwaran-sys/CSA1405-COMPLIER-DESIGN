#include <stdio.h>

int main()
{
    char ch;
    int spaces = 0, newlines = 0;

    printf("Enter text (Press Ctrl+D on Linux/Mac or Ctrl+Z then Enter on Windows to end):\n");

    while ((ch = getchar()) != EOF)
    {
        if (ch == ' ')
            spaces++;
        else if (ch == '\n')
            newlines++;
    }

    printf("Number of whitespaces = %d\n", spaces);
    printf("Number of newline characters = %d\n", newlines);

    return 0;
}
